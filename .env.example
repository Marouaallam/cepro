# ---------------------------------------------------------------------------
# Admin panel (/admin) — set these in Vercel → Project → Settings → Environment Variables
# ---------------------------------------------------------------------------

# Supabase project URL (Supabase → Project Settings → Data API)
SUPABASE_URL=https://your-project.supabase.co

# Supabase SECRET key (sb_secret_...) or legacy service_role key.
# Server-side only — NEVER put it in script.js or any browser file.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Password the CEPRO team types to open /admin (use a long, unique one)
ADMIN_PASSWORD=change-me-to-a-long-password

# Random string used to sign the login cookie (32+ chars).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs everybody out.
ADMIN_SESSION_SECRET=replace-with-64-random-hex-characters

# Optional — table name (default: leads)
SUPABASE_TABLE=leads

# ---------------------------------------------------------------------------
# Meta Conversions API (api/meta-lead.js) — server-side "Lead" event
# ---------------------------------------------------------------------------

# Same numeric Pixel ID as CONFIG.META_PIXEL_ID in script.js (Events Manager)
META_PIXEL_ID=

# Events Manager → Pixel → Settings → Conversions API → Generate access token.
# SECRET — server-side only, never in script.js.
META_CAPI_ACCESS_TOKEN=

# Optional — Graph API version (default v23.0)
META_API_VERSION=

# Optional — only while testing (Events Manager → Test events). Remove for production.
META_TEST_EVENT_CODE=

# Note: the public form (script.js) still uses the publishable key hard-coded in CONFIG;
# that key is safe to expose because RLS only allows INSERT on the leads table.
